# Copy to server/.env and adjust, or just set these in your shell.

# Where the OAuth client file and cached token live (defaults are next to the script).
GMAIL_CREDENTIALS=./credentials.json
GMAIL_TOKEN=./token.json

# Port the service listens on. The app expects 8000.
PORT=8000

# CORS. "*" is fine for local dev; lock to your app origin in production.
ALLOWED_ORIGINS=*

# Gmail search used by /api/inbox when the caller doesn't pass ?query=
GMAIL_QUERY=(subject:tracker OR subject:commissioning OR subject:POD OR subject:"plan of the day" OR "Limon III") newer_than:60d
